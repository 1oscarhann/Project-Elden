# Neon connection string. Use the pooled endpoint.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# 32+ chars. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

TOKEN_TTL_HOURS=12

# Comma-separated origins for the web build. Do not ship "*" to production.
ALLOWED_ORIGINS=https://your-game.onrender.com
