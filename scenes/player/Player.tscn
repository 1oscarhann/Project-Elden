[sub_resource type="RectangleShape2D" id="shape_feet"]
; ⚠️ 12 wide, NOT 16. A 16px body in a 16px doorway has zero clearance: centred
; in the gap it touches both jambs at once and move_and_slide refuses to pass,
; so the hut could be entered (its outside door is a free-standing Area2D) but
; never left. A character wants to be narrower than the gaps it walks through.
size = Vector2(12, 8)

