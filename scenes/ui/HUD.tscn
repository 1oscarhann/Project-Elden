[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="script_hud"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("script_hud")

[node name="ColdOverlay" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.35, 0.55, 1, 0)
mouse_filter = 2

[node name="Readout" type="VBoxContainer" parent="."]
anchors_preset = 0
offset_left = 6.0
offset_top = 4.0
offset_right = 260.0
offset_bottom = 70.0
theme_override_constants/separation = 1

[node name="Clock" type="Label" parent="Readout"]
layout_mode = 2
text = "Day 1   08:00   DAY"

[node name="WarmthLabel" type="Label" parent="Readout"]
layout_mode = 2
text = "Warmth 100"

[node name="Warmth" type="ProgressBar" parent="Readout"]
custom_minimum_size = Vector2(120, 8)
layout_mode = 2
max_value = 100.0
value = 100.0
show_percentage = false

[node name="Hint" type="Label" parent="Readout"]
layout_mode = 2
text = "WASD · Shift run · E use · Tab bag · C craft · F consume"
