[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="script_hud"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("script_hud")

[node name="ColdOverlay" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.35, 0.55, 1, 0)
mouse_filter = 2

[node name="Frame" type="PanelContainer" parent="."]
offset_left = 5.0
offset_top = 4.0
offset_right = 197.0
offset_bottom = 70.0
mouse_filter = 2

[node name="Readout" type="VBoxContainer" parent="Frame"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 1

[node name="Clock" type="Label" parent="Frame/Readout"]
layout_mode = 2
theme_type_variation = &"PanelText"
theme_override_font_sizes/font_size = 11
text = "Day 1   08:00   DAY"

[node name="WarmthLabel" type="Label" parent="Frame/Readout"]
layout_mode = 2
theme_type_variation = &"PanelTextDim"
theme_override_font_sizes/font_size = 9
text = "Warmth 100"

[node name="Warmth" type="ProgressBar" parent="Frame/Readout"]
custom_minimum_size = Vector2(120, 9)
layout_mode = 2
max_value = 100.0
value = 100.0
show_percentage = false

[node name="Hint" type="Label" parent="Frame/Readout"]
layout_mode = 2
theme_type_variation = &"PanelTextDim"
theme_override_font_sizes/font_size = 7
text = "WASD · Shift run · E use · Tab bag
C craft · B build · F consume"
