[node name="Main" type="Node2D"]
script = ExtResource("script_game")

; FIRST on purpose. _unhandled_input runs in reverse tree order, so the node
; listed first hears Esc LAST — after the bag, the craft menu and build mode
; have each had their chance to close instead. Its `layer` keeps it on top.
[node name="PauseMenu" parent="." instance=ExtResource("pause")]

[node name="Rooms" type="Node2D" parent="."]
script = ExtResource("script_rooms")

[node name="World" parent="Rooms" instance=ExtResource("world")]

[node name="Player" parent="Rooms" instance=ExtResource("player")]

[node name="HUD" parent="." instance=ExtResource("hud")]

[node name="Hotbar" parent="." instance=ExtResource("hotbar")]

[node name="InventoryPanel" parent="." instance=ExtResource("bag")]

