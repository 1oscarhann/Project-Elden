; Engine configuration file.
; Cozy Island Survival — hand-authored in Phase 0 (docs/phases/phase00_setup.md).
; Godot rewrites this file when the editor saves; keep comments short.

config_version=5

[application]

config/name="Cozy Island Survival"
config/description="A cozy 2D angled-top-down pixel-art island survival game. No permadeath, no combat."
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

; DayNight must come first: GameState reads its phase in _ready.
DayNight="*res://scripts/globals/day_night.gd"
GameState="*res://scripts/globals/game_state.gd"
; ItemDB before Inventory: stack limits are looked up through it.
ItemDB="*res://scripts/globals/item_db.gd"
Inventory="*res://scripts/globals/inventory.gd"
Crafting="*res://scripts/globals/crafting.gd"

[display]

; 640x360 integer-scales cleanly to 720p (2x), 1080p (3x) and 4K (6x).
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[input]

; WASD + arrows, bound by PHYSICAL keycode so the layout is right on
; AZERTY/QWERTZ too. Serialized by Godot itself, not hand-written.

