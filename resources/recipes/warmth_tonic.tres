[gd_resource type="Resource" script_class="RecipeData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/world/recipe_data.gd" id="script_recipe"]
[ext_resource type="Script" path="res://scripts/world/recipe_ingredient.gd" id="script_ingredient"]

[sub_resource type="Resource" id="ing_berries"]
script = ExtResource("script_ingredient")
item_id = "berries"
count = 1

[sub_resource type="Resource" id="ing_fibre"]
script = ExtResource("script_ingredient")
item_id = "fibre"
count = 1

[resource]
script = ExtResource("script_recipe")
id = "warmth_tonic"
result_item_id = "warmth_tonic"
result_count = 1
ingredients = Array[RecipeIngredient]([SubResource("ing_berries"), SubResource("ing_fibre")])
required_station = "campfire"
unlocked_by_default = true
category = "food"
